{
  "schema": 1,
  "version": "2026-10-28.1",
  "description": "Stackurity's lifecycle mappings on top of endoflife.date. Every product entry was checked against the vendor's or distribution's own package index (sources) on the date given. endoflife.date's own identifiers win unless an entry sets override.",
  "namespace_families": [
    {
      "type": "rpm",
      "namespaces": [
        "redhat",
        "rhel",
        "centos",
        "rocky",
        "almalinux",
        "ol"
      ],
      "why": "Red Hat Enterprise Linux and its rebuilds ship the same package names. The agent reports RHEL packages as pkg:rpm/rhel/..., Syft as pkg:rpm/redhat/..., and endoflife.date lists only some namespaces (redhat, centos), so Rocky Linux, AlmaLinux, Oracle Linux and agent-reported RHEL packages matched nothing. .NET SDK packages are left out: dotnet-runtime-X.Y gives .NET's one finding per release (see the .NET rule in intel), and the SDK would add a second.",
      "except": [
        "dotnet-sdk-*"
      ]
    },
    {
      "type": "deb",
      "namespaces": [
        "debian",
        "ubuntu"
      ],
      "why": "Ubuntu is built from Debian and keeps its binary package names; endoflife.date often lists one of the two (pkg:deb/ubuntu/postgresql, pkg:deb/ubuntu/python3.12)."
    }
  ],
  "products": [
    {
      "product": "electron",
      "purls": [
        "pkg:npm/electron"
      ],
      "sources": [
        "https://registry.npmjs.org/electron/latest",
        "https://endoflife.date/api/v1/products/electron"
      ],
      "verified": "2026-10-28",
      "note": "endoflife.date tracks Electron (release lines are majors) but lists no package identifier."
    },
