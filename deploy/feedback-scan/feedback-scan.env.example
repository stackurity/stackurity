# /etc/stackurity/feedback-scan.env (mode 0600)
FEEDBACK_SCAN_API=http://127.0.0.1:8180
FEEDBACK_SCAN_TOKEN_FILE=/opt/stackurity/secrets/feedback_scanner_token
# The queue's directory on the host: the app's data volume + /feedback.
FEEDBACK_SCAN_DIR=/var/lib/docker/volumes/stackurity_data/_data/feedback
FEEDBACK_SCAN_IMAGE=clamav/clamav:1.5.4_base
FEEDBACK_SCAN_DB_VOLUME=stackurity-clamav-db
FEEDBACK_SCAN_MEMORY=1536m
FEEDBACK_SCAN_MIN_FREE_MIB=1740
